# URL base da API GCEI usada pelo cliente HTTP (src/config/env.ts).
#
# Dev (recomendado): use o proxy do Vite para evitar CORS — o navegador fala
# same-origin com o Vite e ele repassa para a API. Ver server.proxy em
# vite.config.ts.
VITE_API_BASE_URL=/api
#
# Sem proxy / produção: aponte para a API real (requer CORS no backend
# liberando a origem do front, com credentials):
# VITE_API_BASE_URL=http://localhost:3000
#
# Opcional: alvo do proxy de dev (default http://localhost:3000):
# VITE_API_PROXY_TARGET=http://localhost:3000
